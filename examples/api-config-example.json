{
  "version": "1.0",
  "provider": "openai",
  "config": {
    "api_key_env": "OPENAI_API_KEY",
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-4",
    "timeout": 60,
    "max_retries": 3
  },
  "router": {
    "mode": "recommended",
    "tiers": {
      "quick": "gpt-4o-mini",
      "normal": "gpt-4o",
      "advanced": "gpt-4-turbo"
    }
  }
}
